# Пароль входа в админку (обязателен, пустое значение не пройдёт проверку при старте)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=

# Ключ подписи JWT-токенов (обязателен). Рекомендуется не короче 32 символов.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

DATABASE_URL=sqlite:////app/data/cards.db
BOT_TOKEN=
ADMIN_IDS=
TELEGRAM_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/
